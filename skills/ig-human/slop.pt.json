  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bn[aã]o [ée] (?:s[oó]|apenas|somente) (?:sobre )?[^.!?\\n]{2,60}[,.] [ée]\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Fala a única coisa que você quer dizer. Corta a metade da preparação."
    },
    {
      "id": "nao-so-mas",
      "regex": "(?i)\\bn[aã]o s[oó]\\b[^.!?\\n]{2,80}\\bmas (?:tamb[ée]m|sim)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Divide em duas frases ou corta a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\b(?:isso|n[aã]o) (?:n[aã]o )?[ée] sobre [^.!?\\n]{2,60}[.!,] [ée] sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Começa pelo Y. A virada é o sinal de texto pronto."
    },
    {
      "id": "o-resultado",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|a pegadinha|o segredo|sabe o que aconteceu)\\?\\s*$",
      "name": "Pergunta retórica de uma linha",
      "fix": "Responde na mesma frase em vez de encenar uma revelação."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui est[aá]|veja) o que (?:eu|n[oó]s) aprend(?:i|emos)\\b|\\bo que eu aprendi (?:com isso|foi)\\b",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Fala a lição. Pula o anúncio dela."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b[^\\W\\d_]+, [^\\W\\d_]+ e [^\\W\\d_]+\\.",
      "name": "Trinca (regra de três)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão de modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e nenhum desses cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Parede de hashtags (6+)",
      "fix": "O Instagram limita a cinco hashtags por post desde dezembro de 2025. Use até cinco, específicas, ou nenhuma."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[eê]ncia artificial|modelo de linguagem)\\b",
      "name": "Autorreferência de modelo",
      "fix": "Apaga a frase."
    },
    {
      "id": "em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em conclus[aã]o|concluindo|em suma)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-engajamento",
      "regex": "(?i)(?:\\bconcorda\\?|\\bo que (?:voc[eê]s? )?acha(?:m)?\\?|\\bquem mais\\b[^.!?\\n]{0,40}\\?|\\bt[oô] errad[oa]\\?|\\bestou errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento no automático",
      "fix": "Faz uma pergunta que só você faria, sobre a coisa específica acima dela."
    },
    {
      "id": "para-de-rolar",
      "regex": "(?im)^\\s*(?:para|pare) de rolar\\b|^\\s*n[aã]o (?:passa|pula|role)\\b",
      "name": "Abertura \"para de rolar o feed\"",
      "fix": "O que para o dedo tem que ser a própria afirmação. Pedir atenção mostra que você ainda não ganhou."
    },
    {
      "id": "neste-video",
      "regex": "(?i)\\b(?:neste|nesse|no) (?:v[ií]deo|reels?|post)(?: de hoje)?,? (?:eu )?vou\\b|\\bno v[ií]deo de hoje\\b|\\bhoje eu vou (?:te |l?hes? )?(?:mostrar|ensinar)\\b|\\bvou (?:te )?(?:mostrar|ensinar) (?:pra voc[eê]s? )?como\\b",
      "name": "Preâmbulo de vídeo (\"neste vídeo eu vou te mostrar\")",
      "fix": "Apaga e começa pelo resultado. Os dois primeiros segundos decidem o reel inteiro."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF\\u2705\\u27a1\\u2b05\\u2714\\u2728]\\s*\\S",
      "name": "Lista com emoji de marcador",
      "fix": "Usa hífen ou quebra de linha. Emoji como marcador é a coisa com mais cara de template numa legenda."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é volume, não marca-texto. Uma palavra, no máximo."
    },
    {
      "id": "isca-seguir",
      "regex": "(?i)\\b(?:segue (?:pra|para) mais|me segue (?:pra|para)|siga para mais|marca (?:algu[eé]m|aquele amigo|um amigo)|marque algu[eé]m|d[aáê] dois cliques|deixa seu like|comenta (?:aqui )?embaixo se)\\b",
      "name": "Isca de seguir ou marcar no automático",
      "fix": "Peça a única ação que esse post realmente merece. O pedido genérico ensina o público a ignorar todo pedido."
    }
